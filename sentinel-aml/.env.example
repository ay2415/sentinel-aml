# Copy to .env and fill in. Never commit .env. In Azure these come from Key Vault.
ENVIRONMENT=local
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://sentinel:change-me@localhost:5432/sentinel
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# deterministic = offline reference agents (no key) | anthropic = real Claude models
LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001
EMBEDDING_PROVIDER=glove
EMBEDDING_DIM=300
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
